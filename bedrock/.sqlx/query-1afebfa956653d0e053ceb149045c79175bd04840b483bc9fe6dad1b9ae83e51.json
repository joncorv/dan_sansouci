  "query": "\n            INSERT INTO categories (\n                category_id,\n                idx,\n                name,\n                src_img\n            )\n            VALUES ($1, $2, $3, $4)\n            ON CONFLICT (category_id) \n            DO UPDATE set\n                category_id = EXCLUDED.category_id,\n                idx = EXCLUDED.idx,\n                name = EXCLUDED.name,\n                src_img = EXCLUDED.src_img\n            RETURNING\n                category_id,\n                idx,\n                name,\n                src_img\n            ",
